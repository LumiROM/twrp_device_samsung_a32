+// ANSI SGR (ESC[..m) support for the installer console, so update scripts can
+// colourize their ui_print() lines. The console colourizes whole lines, so the
+// last foreground color of the line wins. The names returned here are theme
+// variables (see gui/theme/<theme>/ui.xml), resolved by ConvertStrToColor().
+static const char* ansi_color_names[2][8] = {
+	{ "ansi_black", "ansi_red", "ansi_green", "ansi_yellow",
+	  "ansi_blue", "ansi_magenta", "ansi_cyan", "ansi_white" },
+	{ "ansi_bright_black", "ansi_bright_red", "ansi_bright_green", "ansi_bright_yellow",
+	  "ansi_bright_blue", "ansi_bright_magenta", "ansi_bright_cyan", "ansi_bright_white" }
+};
+
+static std::string ansi_color_name(int base, bool bright) {
+	if (base < 0 || base > 7)
+		return "";
+	return ansi_color_names[bright ? 1 : 0][base];
+}
+
+// Removes every ANSI SGR sequence from 'text' and returns the name of the color
+// they ask for, or an empty string to keep the default console color.
+static std::string ansi_strip_sgr(std::string& text) {
+	int base = -1;
+	bool bold = false, bright = false;
+
+	size_t pos = 0;
+	while ((pos = text.find('\x1b', pos)) != std::string::npos) {
+		if (pos + 1 >= text.size() || text[pos + 1] != '[') {
+			++pos;
+			continue;
+		}
+		size_t end = pos + 2;
+		while (end < text.size() && (isdigit((unsigned char)text[end]) || text[end] == ';'))
+			++end;
+		if (end >= text.size() || text[end] != 'm') {
+			// Not an SGR sequence; leave it alone like before.
+			++pos;
+			continue;
+		}
+
+		std::string params = text.substr(pos + 2, end - pos - 2);
+		std::vector<int> args;
+		size_t p = 0;
+		while (true) {
+			size_t semi = params.find(';', p);
+			std::string tok = params.substr(p, semi == std::string::npos ? std::string::npos : semi - p);
+			args.push_back(tok.empty() ? 0 : atoi(tok.c_str()));
+			if (semi == std::string::npos)
+				break;
+			p = semi + 1;
+		}
+
+		for (size_t i = 0; i < args.size(); ++i) {
+			int n = args[i];
+			if (n == 0) {
+				base = -1;
+				bold = false;
+			} else if (n == 1) {
+				bold = true;
+			} else if (n == 22) {
+				bold = false;
+			} else if (n == 39) {
+				base = -1;
+			} else if (n >= 30 && n <= 37) {
+				base = n - 30;
+				bright = bold;
+			} else if (n >= 90 && n <= 97) {
+				base = n - 90;
+				bright = true;
+			} else if (n == 38 || n == 48) {
+				// Extended colour (38;5;N or 38;2;R;G;B): the console only has
+				// named colours, so just skip its parameters.
+				if (i + 1 < args.size() && args[i + 1] == 5)
+					i += 2;
+				else if (i + 1 < args.size() && args[i + 1] == 2)
+					i += 4;
+			}
+		}
+
+		text.erase(pos, end - pos + 1);
+	}
+
+	return ansi_color_name(base, bright);
+}
+
