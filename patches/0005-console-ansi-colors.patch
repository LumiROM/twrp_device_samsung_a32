-				gui_print("%s", display_value);
+				std::string text(display_value);
+				std::string color = ansi_strip_sgr(text);
+				if (color.empty())
+					gui_print("%s", text.c_str());
+				else
+					gui_print_color(color.c_str(), "%s", text.c_str());
 			} else {
 				gui_print("\n");
 			}
