+// Saves the settings if they changed, but at most once every few seconds so
+// that dragging a slider doesn't write the settings file on every frame.
+// This makes settings survive any way of leaving recovery (power button,
+// adb reboot, a raw reboot command, a crash...) instead of only the reboot
+// option of the TWRP GUI, which is the only place that used to flush them.
+int DataManager::FlushIfNeeded()
+{
+#ifndef TW_OEM_BUILD
+	static time_t last_flush = 0;
+	time_t now;
+
+	if (!mPersistDirty || mBackingFile.empty())
+		return 0;
+
+	now = time(NULL);
+	if (last_flush != 0 && now - last_flush < 5)
+		return 0;
+
+	// Keep retrying later instead of showing an error popup from the GUI loop
+	// if the settings storage is not available right now.
+	if (!PartitionManager.Mount_Settings_Storage(false))
+		return 0;
+
+	last_flush = now;
+	mPersistDirty = false;
+	return SaveValues();
+#else
+	return 0;
+#endif
+}
