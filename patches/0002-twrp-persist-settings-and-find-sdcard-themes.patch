@@ -1511,6 +1511,36 @@ exit:
 	return TW_DEFAULT_RECOVERY_FOLDER;
 }
 
+// Returns the path to a custom theme's ui.zip, or an empty string if there is none.
+// TWRP 12.1 moved the settings storage to /data/recovery and only looks for the
+// theme there, so themes installed the classic way in the TWRP folder on the
+// sdcard were silently ignored. Check both locations.
+std::string TWFunc::Find_Custom_Theme() {
+	std::string settings_path = DataManager::GetSettingsStoragePath();
+	if (!settings_path.empty()) {
+		if (!PartitionManager.Mount_Settings_Storage(false)) {
+			int retry_count = 5;
+			while (retry_count > 0 && !PartitionManager.Mount_Settings_Storage(false)) {
+				usleep(500000);
+				retry_count--;
+			}
+		}
+		std::string candidate = settings_path + "theme/ui.zip";
+		if (Path_Exists(candidate))
+			return candidate;
+	}
+
+	std::string storage_path = DataManager::GetCurrentStoragePath();
+	if (!storage_path.empty()) {
+		PartitionManager.Mount_By_Path(storage_path, false);
+		std::string candidate = storage_path + TW_DEFAULT_RECOVERY_FOLDER + "/theme/ui.zip";
+		if (Path_Exists(candidate))
+			return candidate;
+	}
+
+	return "";
+}
